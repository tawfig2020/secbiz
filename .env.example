# Aegis runtime configuration (placeholders). Copy to .env or export in the
# Cloud Run environment. All REPLACE_ME_* values are placeholders to be
# swapped for real credentials/keys next week.
AEGIS_ENVIRONMENT=local
AEGIS_GCP_PROJECT_ID=REPLACE_ME_PROJECT_ID
AEGIS_GCP_REGION=us-central1
AEGIS_CLOUD_RUN_SERVICE=aegis
AEGIS_KMS_PROVIDER=fake
AEGIS_KMS_KEY_RING=aegis-keyring
AEGIS_KMS_KEY=aegis-attestation-key
AEGIS_KMS_KEY_VERSION=1
AEGIS_GEMINI_MODEL=gemini-2.5-flash
AEGIS_GEMINI_PROJECT=REPLACE_ME_PROJECT_ID
AEGIS_GEMINI_LOCATION=us-central1
# Hackathon/demo deployment (see docs/deploy-gcp.md):
AEGIS_GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
AEGIS_FIRESTORE_PROJECT=REPLACE_ME_PROJECT_ID
AEGIS_FIRESTORE_COLLECTION=aegis_events
AEGIS_PUBLIC_DEMO=0
# Cloud Run injects PORT and K_SERVICE automatically; no config needed.
AEGIS_FEED_FSISAC_URL=https://feeds.fsisac.com/aegis/signatures.json
AEGIS_FEED_HISAC_URL=https://feeds.h-isac.org/aegis/signatures.json
AEGIS_FEED_CISA_URL=https://feeds.cisa.gov/aegis/signatures.json
AEGIS_FEED_FSISAC_API_KEY=REPLACE_ME_FSISAC_API_KEY
AEGIS_FEED_HISAC_API_KEY=REPLACE_ME_HISAC_API_KEY
AEGIS_FEED_CISA_API_KEY=REPLACE_ME_CISA_API_KEY
AEGIS_STRIPE_API_KEY=REPLACE_ME_STRIPE_API_KEY
AEGIS_DATABASE_URL=REPLACE_ME_DATABASE_URL
